#!/usr/bin/env python3
"""
前端端到端：本地 anvil + 注入 EIP-1193 假钱包，真跑一遍「连接 → 看盘口 → 买入 → 看持仓」。

前置：
  anvil --chain-id 31337 --port 8545
  forge script DeployCentral + 建盘 + 做市（见 frontend/README.md「本地联调」）
  vite dev 带 VITE_ENGINE_ADDRESS / VITE_USDC_ADDRESS / VITE_RPC_URL 指向 anvil
"""
import json
import sys
from playwright.sync_api import sync_playwright

URL = "http://127.0.0.1:5173/"
RPC = "http://127.0.0.1:8545"
ACCOUNT = "0x70997970C51812dc3A010C7d01b50e0d17dc79C8"  # anvil #1

INJECT = """
(() => {
  const RPC = "%s";
  const ACCOUNT = "%s";
  let id = 1;
  const provider = {
    isMetaMask: true,
    async request({ method, params }) {
      if (method === "eth_requestAccounts" || method === "eth_accounts") return [ACCOUNT];
      if (method === "eth_chainId") return "0x2105";
      if (method === "wallet_switchEthereumChain" || method === "wallet_addEthereumChain") return null;
      const body = { jsonrpc: "2.0", id: id++, method, params: params || [] };
      if (method === "eth_sendTransaction" && body.params[0] && !body.params[0].from) {
        body.params[0].from = ACCOUNT;
      }
      const res = await fetch(RPC, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) });
      const json = await res.json();
      if (json.error) { const e = new Error(json.error.message); e.code = json.error.code; throw e; }
      return json.result;
    },
    on() {}, removeListener() {},
  };
  window.ethereum = provider;
  const info = { uuid: "e2e-fake", name: "E2E 假钱包", icon: "", rdns: "e2e.fake" };
  const announce = () => window.dispatchEvent(new CustomEvent("eip1193:announceProvider".replace("eip1193", "eip6963"), { detail: { info, provider } }));
  window.addEventListener("eip6963:requestProvider", announce);
  announce();
})();
""" % (RPC, ACCOUNT)


def main():
    steps = []
    with sync_playwright() as pw:
        b = pw.chromium.launch(headless=True, args=["--no-sandbox"])
        ctx = b.new_context(viewport={"width": 1440, "height": 1000}, locale="zh-CN")
        ctx.add_init_script(INJECT)
        pg = ctx.new_page()
        errs = []
        pg.on("pageerror", lambda e: errs.append(str(e)))
        pg.on("console", lambda m: errs.append(f"console.{m.type}: {m.text}") if m.type == "error" else None)

        pg.goto(URL, wait_until="networkidle", timeout=90_000)
        pg.wait_for_timeout(2500)

        # 0) 合规风险弹窗 + 新用户欢迎礼包（都会挡住首屏，先按真实用户路径关掉）
        if "我已了解风险，进入市场" in pg.inner_text("body"):
            pg.get_by_role("button", name="我已了解风险，进入市场").click()
            pg.wait_for_timeout(1600)
        if "开始对赌" in pg.inner_text("body"):
            pg.get_by_role("button", name="开始对赌").first.click()
            pg.wait_for_timeout(600)
        # 本条用例验的是「真链交易」，切到实盘模式（默认已锁定模拟演练）
        pg.get_by_role("button", name="实盘 Real").first.click()
        pg.wait_for_timeout(900)

        body = pg.inner_text("body")
        # 新版大厅用统计条展示链上盘口数（示例盘口不算链上），断言「链上盘口 / 2」
        steps.append(("首次加载读到 2 个盘口", "链上盘口" in body and "\n2\n" in body))
        steps.append(("盘口标题渲染", "BTC 能否在 24 小时内突破" in body))
        steps.append(("YES 概率 50%", "50.0%" in body))

        # 连接钱包
        pg.get_by_role("button", name="连接钱包").first.click()
        pg.wait_for_timeout(600)
        pg.get_by_role("button", name="E2E 假钱包").click()
        pg.wait_for_timeout(1500)
        body = pg.inner_text("body")
        steps.append(("钱包连接成功（显示地址/余额）", "0x7099" in body and "USDC" in body))

        # 打开第一个链上盘口详情（严格限定在链上大厅，避免命中示例盘口）
        pg.locator('[data-testid="chain-hall"]').get_by_text("BTC 能否在 24 小时内突破").first.click()
        pg.wait_for_timeout(1200)
        steps.append(("详情面板打开", "盘口数据" in pg.inner_text("body")))

        # 输入 20 USDC，等报价
        pg.locator('input[placeholder="0.00"]').fill("20")
        pg.wait_for_timeout(2500)
        detail = pg.inner_text("body")
        steps.append(("链上报价出现", "链上报价" in detail))
        steps.append(("冲击百分比显示", "价格冲击" in detail))

        # 买入
        pg.get_by_role("button", name="买入 YES").click()
        pg.wait_for_timeout(6000)
        after = pg.inner_text("body")
        steps.append(("交易确认 Toast", "链上已确认" in after or "SharesBought" in after))
        pg.screenshot(path="/tmp/fe_after_buy.png", full_page=True)

        # 持仓页
        pg.get_by_role("button", name="关闭").click()
        pg.wait_for_timeout(400)
        pg.get_by_role("button", name="我的持仓", exact=True).click()
        pg.wait_for_timeout(3000)
        port = pg.inner_text("body")
        import re as _re
        m = _re.search(r"YES (\d+(?:\.\d+)?)", port)
        steps.append((f"持仓页出现份额（{m.group(0) if m else '无'}）", bool(m) and float(m.group(1)) > 0))
        print("---- 持仓页文本 ----")
        print("\n".join([l for l in port.split("\n") if l.strip()][:22]))
        steps.append(("可提现/交易中分组", "交易中" in port or "可提现" in port))
        pg.screenshot(path="/tmp/fe_portfolio.png", full_page=True)

        # 事件流
        pg.get_by_role("button", name="链上事件", exact=True).click()
        pg.wait_for_timeout(3500)
        act = pg.inner_text("body")
        steps.append(("事件流出现买入事件", "买入成交" in act))
        pg.screenshot(path="/tmp/fe_activity.png", full_page=True)
        b.close()

    ok = True
    for name, passed in steps:
        print(("PASS " if passed else "FAIL ") + name)
        ok = ok and passed
    hard = [e for e in errs if "429" not in e and "Download the React" not in e]
    if hard:
        print("---- 页面错误 ----")
        for e in hard[:8]:
            print(" ", e)
    print("RESULT:", "ALL PASS" if ok and not hard else "HAS FAILURES")
    return 0 if ok and not hard else 1


if __name__ == "__main__":
    sys.exit(main())
