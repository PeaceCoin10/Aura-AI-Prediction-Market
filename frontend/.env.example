# Deployed contracts on Base mainnet (defaults; edit here to switch chains)
# For local anvil runs, use the addresses printed by DeployCentral
VITE_ENGINE_ADDRESS=0xE6056Bc6700F6d7E6fF8779B212655284dc1631C
VITE_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Read-only RPCs (comma-separated, tried in order; llamarpc sends no CORS headers, do not add it)
VITE_RPC_URL=https://base-rpc.publicnode.com,https://1rpc.io/base,https://mainnet.base.org

# -- Telegram Mini App -------------------------------------------------------
# Bot handle used to mint deep links: https://t.me/<bot>/<app>?startapp=market_<id>
VITE_TG_BOT=AuraPredictBot
VITE_TG_APP=app

# -- Zero-friction entry (optional) ------------------------------------------
# Web3Auth client id: enables Google / email smart-account login in the connect modal.
VITE_WEB3AUTH_CLIENT_ID=
# ERC-4337 bundler + paymaster (Pimlico / Biconomy / Alchemy). Both unset = no sponsored gas.
VITE_BUNDLER_URL=
VITE_PAYMASTER_URL=

# -- Affiliate ---------------------------------------------------------------
# ReferralLedger address. Unset = the affiliate drawer shows a local estimate and no claim button.
VITE_REFERRAL_LEDGER=
