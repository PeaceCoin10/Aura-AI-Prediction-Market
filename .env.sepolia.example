# Base Sepolia 部署环境模板（复制成 .env.sepolia 后填真实值；.env* 已在 .gitignore）
# 用法：set -a; source .env.sepolia; set +a

# ── 网络 ────────────────────────────────────────────────────────────────
BASE_RPC_URL=https://sepolia.base.org
# 备用：https://base-sepolia-rpc.publicnode.com
# chainId = 84532

# ── 部署者（只要 gas，不需要任何特权；部署完权限会被两步移交给 Safe）──
PRIVATE_KEY=0x<DEPLOYER_PRIVATE_KEY_64_HEX>

# ── 收款地址（ProtocolFeeVault.treasury，必须是多签）──────────────────
TREASURY=0x<TREASURY_SAFE>

# ── 首个盘口的结算管理员（必须能真的发起 resolve，建议同一个 Safe）────
MARKET_ADMIN=0x<MARKET_ADMIN_SAFE>

# ── 两步移交目标（脚本只做第 1 步 transferAdmin；第 2 步由它自己 accept）
# 留空 = 不移交，admin 留在部署 EOA 上（仅限本地演练）
ADMIN_TRANSFER_TO=0x<PROTOCOL_SAFE>

# ── 抵押品：Base Sepolia Circle USDC（实测 symbol=USDC, decimals=6）────
USDC=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# ── 首个盘口参数（6 参建盘）────────────────────────────────────────────
# cast keccak "SEPOLIA-BTC-100K-2026Q4"
CONDITION_ID=0x<32_BYTE_HEX>
# date -d "+30 days" +%s
RESOLUTION_TIME=<UNIX_TIMESTAMP>
MIN_BET=5000000
MAX_BET=10000000000
MAX_IMPACT_BPS=500

# ── 合约验证（Basescan V1 已废弃，必须用 Etherscan V2 多链 key）─────────
ETHERSCAN_API_KEY=<ETHERSCAN_V2_KEY>

# ── Keeper（只给 permissionless 动作的私钥，绝不是 admin 私钥）─────────
KEEPER_RPC_URL=https://sepolia.base.org
KEEPER_FACTORY=<部署输出 PredictionFactory>
KEEPER_FEE_VAULT=<部署输出 ProtocolFeeVault>
KEEPER_PRIVATE_KEY=0x<KEEPER_PRIVATE_KEY_64_HEX>
KEEPER_FEE_THRESHOLD=10000000
KEEPER_AUTO_REFUND=0
KEEPER_INTERVAL_MS=30000
KEEPER_WEBHOOK=
