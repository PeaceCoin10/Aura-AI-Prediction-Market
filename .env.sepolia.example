# Base Sepolia deployment template (copy to .env.sepolia and fill in real values; .env* is gitignored)
# Usage: set -a; source .env.sepolia; set +a

# -- Network -------------------------------------------------------------
BASE_RPC_URL=https://sepolia.base.org
# Fallback: https://base-sepolia-rpc.publicnode.com
# chainId = 84532

# -- Deployer (gas only, no privileges; authority is handed to the Safe in two steps) --
PRIVATE_KEY=0x<DEPLOYER_PRIVATE_KEY_64_HEX>

# -- Treasury (ProtocolFeeVault.treasury; must be a multisig) ------------
TREASURY=0x<TREASURY_SAFE>

# -- Resolution admin for the first market (must be able to call resolve; use the same Safe) --
MARKET_ADMIN=0x<MARKET_ADMIN_SAFE>

# -- Two-step handover target (the script only does step 1 transferAdmin; step 2 is its own accept)
# Empty = no handover; admin stays on the deployer EOA (local rehearsals only)
ADMIN_TRANSFER_TO=0x<PROTOCOL_SAFE>

# -- Collateral: Base Sepolia Circle USDC (verified symbol=USDC, decimals=6) --
USDC=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# -- First market parameters (6-argument creation) ----------------------
# cast keccak "SEPOLIA-BTC-100K-2026Q4"
CONDITION_ID=0x<32_BYTE_HEX>
# date -d "+30 days" +%s
RESOLUTION_TIME=<UNIX_TIMESTAMP>
MIN_BET=5000000
MAX_BET=10000000000
MAX_IMPACT_BPS=500

# -- Contract verification (Basescan V1 is retired; use an Etherscan V2 multichain key) --
ETHERSCAN_API_KEY=<ETHERSCAN_V2_KEY>

# -- Keeper (key for permissionless actions only, never the admin key) --
KEEPER_RPC_URL=https://sepolia.base.org
KEEPER_FACTORY=<deployment output: PredictionFactory>
KEEPER_FEE_VAULT=<deployment output: ProtocolFeeVault>
KEEPER_PRIVATE_KEY=0x<KEEPER_PRIVATE_KEY_64_HEX>
KEEPER_FEE_THRESHOLD=10000000
KEEPER_AUTO_REFUND=0
KEEPER_INTERVAL_MS=30000
KEEPER_WEBHOOK=
