# Base mainnet deployment template (copy to .env.mainnet and fill in real values; .env* is gitignored)
# chainId 8453 / USDC 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# Usage: set -a; source .env.mainnet; set +a
#
# Three differences from the testnet template, all enforced:
#   1. REQUIRE_SAFE_CONTRACT defaults to true: TREASURY / MARKET_ADMIN / ADMIN_TRANSFER_TO
#      must all be contracts (Safe multisigs); an EOA fails the require outright.
#   2. Mainnet USDC is real money: the script staticcalls decimals() and requires 6.
#   3. Market admin = MARKET_ADMIN (written at creation), so MARKET_ADMIN must be a Safe able to call resolve.

# -- Network -------------------------------------------------------------
BASE_RPC_URL=https://mainnet.base.org
# In production use a paid full node (Alchemy / QuickNode / dRPC), plus a separate private/MEV-protected RPC for submission
# Fallback: https://base.llamarpc.com
# chainId = 8453

# -- Deployer (gas only, no privileges; after deployment all authority sits with the Safe) --
PRIVATE_KEY=0x<DEPLOYER_PRIVATE_KEY_64_HEX>

# -- The three entries below must be Safe contract addresses (the script checks code.length) --
# Platform treasury (ProtocolFeeVault.treasury); all fees are sent here
TREASURY=0x<TREASURY_SAFE>
# Market resolution admin: must be able to call resolve(uint8); use the same Safe as ADMIN_TRANSFER_TO
MARKET_ADMIN=0x<MARKET_ADMIN_SAFE>
# Two-step handover target: the script performs step 1 (transferAdmin); step 2 is its own acceptAdmin
ADMIN_TRANSFER_TO=0x<PROTOCOL_SAFE>

# -- Collateral: native Base mainnet USDC (verified symbol=USDC, decimals=6) --
USDC=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# -- First market parameters (6-argument creation) ----------------------
# cast keccak "BTC-100K-2026Q4"
CONDITION_ID=0x<32_BYTE_HEX>
# date -d "+90 days" +%s   (the first mainnet market should run >= 30 days so it cannot enter the refund window immediately)
RESOLUTION_TIME=<UNIX_TIMESTAMP>
MIN_BET=5000000
MAX_BET=10000000000
MAX_IMPACT_BPS=500

# -- Mainnet hardening switch (default true, leave it on) ----------------
REQUIRE_SAFE_CONTRACT=true

# -- Contract verification: Basescan V1 is retired; an Etherscan V2 multichain key is required --
ETHERSCAN_API_KEY=<ETHERSCAN_V2_KEY>

# -- Keeper: a separate hot wallet for permissionless actions only, never the admin key --
KEEPER_RPC_URL=https://mainnet.base.org
KEEPER_FACTORY=<deployment output: PredictionFactory>
KEEPER_FEE_VAULT=<deployment output: ProtocolFeeVault>
KEEPER_PRIVATE_KEY=0x<KEEPER_PRIVATE_KEY_64_HEX>
KEEPER_FEE_THRESHOLD=100000000
KEEPER_AUTO_REFUND=0
KEEPER_INTERVAL_MS=30000
KEEPER_WEBHOOK=<DingTalk / Feishu / Slack webhook>

# -- Frontend submission route (the SDK's MEV-protected path; the SDK embeds no keys) --
# Private / MEV-protected RPC (pay-per-request provider) used for eth_sendRawTransaction
PRIVATE_RPC_URL=<MEV_PROTECTED_RPC_URL>
PRIVATE_RPC_KEY=<PROVIDER_API_KEY>
