# Base 主网部署环境模板（复制成 .env.mainnet 后填真实值；.env* 已在 .gitignore）
# chainId 8453 / USDC 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# 用法：set -a; source .env.mainnet; set +a
#
# 与测试网模板的三处差异（都是硬性的）：
#   1. REQUIRE_SAFE_CONTRACT 默认 true：TREASURY / MARKET_ADMIN / ADMIN_TRANSFER_TO
#      必须都是**合约**（Safe 多签），EOA 直接 require 失败，别想用热钱包一把梭。
#   2. 主网 USDC 是真钱合约，脚本会 staticcall decimals() 必须等于 6。
#   3. 盘口 admin = MARKET_ADMIN（建盘时写入），所以 MARKET_ADMIN 必须是能真的发起 resolve 的 Safe。

# ── 网络 ────────────────────────────────────────────────────────────────
BASE_RPC_URL=https://mainnet.base.org
# 生产建议换成付费全节点（Alchemy / QuickNode / dRPC），并另外准备一个"私有/MEV 保护"RPC 给前端提交用
# 备用：https://base.llamarpc.com
# chainId = 8453

# ── 部署者（只要 gas，不需要任何特权；部署完权限全部在 Safe 手里）───────
PRIVATE_KEY=0x<DEPLOYER_PRIVATE_KEY_64_HEX>

# ── 以下三个必须是 Safe 合约地址（脚本会 code.length 检查）──────────────
# 平台收款（ProtocolFeeVault.treasury），手续费全部打到这里
TREASURY=0x<TREASURY_SAFE>
# 盘口结算管理员：必须能真的发起 resolve(uint8)，建议与 ADMIN_TRANSFER_TO 同一个 Safe
MARKET_ADMIN=0x<MARKET_ADMIN_SAFE>
# 两步移交目标：脚本执行第 1 步 transferAdmin；第 2 步由它自己 acceptAdmin
ADMIN_TRANSFER_TO=0x<PROTOCOL_SAFE>

# ── 抵押品：Base 主网原生 USDC（实测 symbol=USDC, decimals=6）───────────
USDC=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# ── 首个盘口参数（6 参建盘）────────────────────────────────────────────
# cast keccak "BTC-100K-2026Q4"
CONDITION_ID=0x<32_BYTE_HEX>
# date -d "+90 days" +%s   （主网首盘建议 ≥ 30 天，避免刚上线就进退款窗口）
RESOLUTION_TIME=<UNIX_TIMESTAMP>
MIN_BET=5000000
MAX_BET=10000000000
MAX_IMPACT_BPS=500

# ── 主网硬化开关（默认 true，别关）─────────────────────────────────────
REQUIRE_SAFE_CONTRACT=true

# ── 合约验证：Basescan V1 已废弃，必须 Etherscan V2 多链 key ─────────────
ETHERSCAN_API_KEY=<ETHERSCAN_V2_KEY>

# ── Keeper：只给 permissionless 动作的独立热钱包，绝不是 admin 私钥 ──────
KEEPER_RPC_URL=https://mainnet.base.org
KEEPER_FACTORY=<部署输出 PredictionFactory>
KEEPER_FEE_VAULT=<部署输出 ProtocolFeeVault>
KEEPER_PRIVATE_KEY=0x<KEEPER_PRIVATE_KEY_64_HEX>
KEEPER_FEE_THRESHOLD=100000000
KEEPER_AUTO_REFUND=0
KEEPER_INTERVAL_MS=30000
KEEPER_WEBHOOK=<钉钉/飞书/Slack webhook>

# ── 前端提交路由（SDK 的 MEV 保护口子，SDK 本身不内置任何 key）──────────
# 私有/MEV 保护 RPC（按量付费 provider），前端用它做 eth_sendRawTransaction
PRIVATE_RPC_URL=<MEV_PROTECTED_RPC_URL>
PRIVATE_RPC_KEY=<PROVIDER_API_KEY>
